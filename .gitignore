# Publish only instructions, scripts, and one selected demo video.
*
!.gitignore
!README.md
!AGENTS.md
!scripts/
!scripts/install.sh
!scripts/run_orange_juice.sh
!demos/
!demos/main_orange_juice.mp4
!demos/main_orange_juice.gif

# Light demo
!my-vla-light-demo/
!my-vla-light-demo/.gitignore
!my-vla-light-demo/README.md
!my-vla-light-demo/web/
!my-vla-light-demo/web/*.html
!my-vla-light-demo/web/*.css
!my-vla-light-demo/web/*.js
!my-vla-light-demo/firmware/
!my-vla-light-demo/firmware/esp32_light/
!my-vla-light-demo/firmware/esp32_light/platformio.ini
!my-vla-light-demo/firmware/esp32_light/src/
!my-vla-light-demo/firmware/esp32_light/src/main.cpp
!my-vla-light-demo/firmware/esp32_light/src/config.example.h

# Scripts
!my-vla-light-demo/scripts/
!my-vla-light-demo/scripts/**

# LoRA model
!my-vla-light-demo/models/
!my-vla-light-demo/models/light_lora_1000/
!my-vla-light-demo/models/light_lora_1000/pretrained_model/
!my-vla-light-demo/models/light_lora_1000/pretrained_model/**

# Dataset
!my-vla-light-demo/datasets/
!my-vla-light-demo/datasets/light_switch_demo/
!my-vla-light-demo/datasets/light_switch_demo/**

# AgriVLA handoff and implementation records (no generated data).
!AGRIVLA_CODEX_CONTEXT_2026-11-05.md
!AGRIVLA_IMPLEMENTATION_PLAN_2026-11-05.md
!AGRIVLA_IMPLEMENTATION_PROMPTS_2026-11-05.md
!AGRIVLA_IMPLEMENTATION_STATUS.md

# Soybean module: allow only source, configuration, documentation and fixtures.
!agri-soybean-vla/
!agri-soybean-vla/*.md
!agri-soybean-vla/pyproject.toml
!agri-soybean-vla/requirements-data.lock.txt
!agri-soybean-vla/requirements-train.constraints.txt
!agri-soybean-vla/requirements-train.lock.txt
!agri-soybean-vla/src/
!agri-soybean-vla/src/agri_vla/
!agri-soybean-vla/src/agri_vla/*.py
!agri-soybean-vla/src/agri_vla/model_contract.json
!agri-soybean-vla/src/agri_vla/web/
!agri-soybean-vla/src/agri_vla/web/*.html
!agri-soybean-vla/src/agri_vla/web/*.css
!agri-soybean-vla/src/agri_vla/web/*.js
!agri-soybean-vla/scripts/
!agri-soybean-vla/scripts/*.sh
!agri-soybean-vla/configs/
!agri-soybean-vla/configs/*.yaml
!agri-soybean-vla/configs/*.json
!agri-soybean-vla/schemas/
!agri-soybean-vla/schemas/*.schema.json
!agri-soybean-vla/examples/
!agri-soybean-vla/examples/scene_pair.example.jsonl
!agri-soybean-vla/tests/
!agri-soybean-vla/tests/test_*.py

# Keep local/generated contents ignored even inside allowlisted directories.
agri-soybean-vla/**/__pycache__/
agri-soybean-vla/**/*.pyc
agri-soybean-vla/**/*.egg-info/
agri-soybean-vla/.venv/
agri-soybean-vla/.venv-train/
agri-soybean-vla/.tools/
agri-soybean-vla/.vendor/
agri-soybean-vla/.cache/
agri-soybean-vla/.pytest_cache/
agri-soybean-vla/build/
agri-soybean-vla/dist/
agri-soybean-vla/data/
agri-soybean-vla/models/
agri-soybean-vla/outputs/
agri-soybean-vla/reports/
